generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum EntityType {
  company
  person
  opportunity
  activity
  note
  meeting
}

// ---------- Meeting Intelligence ----------

enum ProcessingStatus {
  pending
  extracting
  transcribing
  analyzing
  ready
  failed
}

enum ProposalStatus {
  pending
  applying
  approved
  rejected
  partially_approved
  applied
  partially_applied
  failed
  partially_reverted
  reverted
}

enum CustomFieldType {
  text
  number
  boolean
  date
  select
  multiselect
}

enum Role {
  ADMIN
  MEMBER
}

enum LossReason {
  PRICE
  CHOSE_COMPETITOR
  NO_BUDGET
  DEPRIORITIZED
  SOLVED_INTERNALLY
  CONTACT_OR_ORG_CHANGE
  NO_RESPONSE
  NOT_QUALIFIED
  OTHER
}

// ---------- Multi-tenancy ----------

// Cada empresa cliente del SaaS. Los settings viven inline (pocos campos,
// sin billing) para evitar un join extra por request.
model Organization {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)

  currency    String  @default("CLP") // ISO 4217
  timezone    String  @default("America/Santiago") // IANA
  locale      String  @default("es-CL") // BCP 47, solo afecta formateo Intl
  brandName   String? // fallback: name
  logoUrl     String?
  accentColor String  @default("#0f766e")

  // Gateway de integraciones por org; si es null se usa el env global.
  integrationGatewayUrl    String?
  // Cifrado AES-256-GCM con SETTINGS_ENCRYPTION_KEY; nunca se muestra en UI.
  integrationGatewaySecret String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                         User[]
  pipelineStages                PipelineStage[]
  invitations                   Invitation[]
  passwordResetTokens           PasswordResetToken[]
  companies                     Company[]
  people                        Person[]
  opportunities                 Opportunity[]
  activities                    Activity[]
  activityPeople                ActivityPerson[]
  notes                         Note[]
  savedViews                    SavedView[]
  customFieldDefinitions        CustomFieldDefinition[]
  customFieldValues             CustomFieldValue[]
  workflows                     Workflow[]
  workflowLogs                  WorkflowLog[]
  integrationDeliveries         IntegrationDelivery[]
  inboundLeads                  InboundLead[]
  teamMembers                   TeamMember[]
  meetings                      Meeting[]
  evidence                      Evidence[]
  changeProposals               CRMChangeProposal[]
  changeItems                   CRMChangeItem[]
  agentChatThreads              AgentChatThread[]
  agentChatMessages             AgentChatMessage[]
  agentAttachments              AgentAttachment[]
  timelineEvents                TimelineEvent[]
  entityContextSources          EntityContextSource[]
  entityContextProfiles         EntityContextProfile[]
  telegramLinks                 TelegramLink[]
  telegramLinkCodes             TelegramLinkCode[]
  mcpAccessTokens               McpAccessToken[]
  personCompanyRelationships    PersonCompanyRelationship[]
  commercialPartners            CommercialPartner[]
  companyCommercialPartners     CompanyCommercialPartner[]
  opportunityCommercialPartners OpportunityCommercialPartner[]
  commercialOffers              CommercialOffer[]
  commercialOfferLineItems      CommercialOfferLineItem[]
  commercialOfferDocuments      CommercialOfferDocument[]
  commercialOfferProfitShares   CommercialOfferProfitShare[]
  businessHolidays              BusinessHoliday[]

  @@map("organizations")
}

// Etapas del pipeline configurables por organización (reemplaza al enum
// OpportunityStage). `key` es un slug estable que usan el agente y webhooks.
model PipelineStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  label          String
  sortOrder      Int
  color          String?
  isWon          Boolean      @default(false)
  isLost         Boolean      @default(false)
  // Retirar en vez de borrar cuando la etapa tiene oportunidades.
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  opportunities Opportunity[]

  @@unique([organizationId, key])
  @@unique([organizationId, sortOrder])
  @@index([organizationId])
  @@map("pipeline_stages")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role         @default(MEMBER)
  // sha256 del token; el token crudo solo se muestra/envía una vez.
  tokenHash      String       @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, email])
  @@map("invitations")
}

model PasswordResetToken {
  id             String        @id @default(cuid())
  // Nullable: los super-admins sin org también pueden resetear password.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String        @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- Core CRM entities ----------

model Company {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name            String
  website         String?
  industry        String?
  size            String?
  country         String?
  city            String?
  linkedinUrl     String?
  description     String?      @db.Text
  icpScore        Int?
  fitScore        Int?
  painScore       Int?
  status          String       @default("active")
  source          String?
  priority        String?
  mainPain        String?      @db.Text
  productInterest String?
  potentialValue  Decimal?     @db.Decimal(14, 2)
  buyingTiming    String?
  urgency         String?
  competitor      String?
  currentProvider String?
  nextStep        String?
  nextStepDueDate DateTime?
  lastContactAt   DateTime?
  createdById     String?
  createdBy       User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdVia      String       @default("manual")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  people                       Person[]
  opportunities                Opportunity[]
  activities                   Activity[]
  notes                        Note[]
  meetings                     Meeting[]
  timelineEvents               TimelineEvent[]
  convertedInboundLeads        InboundLead[]               @relation("InboundLeadConvertedCompany")
  personRelationships          PersonCompanyRelationship[]
  linkedCommercialPartners     CommercialPartner[]         @relation("CommercialPartnerLinkedCompany")
  commercialPartnerAssignments CompanyCommercialPartner[]

  @@index([organizationId, name])
  @@index([organizationId, status])
  @@index([createdById])
  @@map("companies")
}

model Person {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  roleTitle       String?
  linkedinUrl     String?
  isDecisionMaker Boolean      @default(false)
  isSponsor       Boolean      @default(false)
  notes           String?      @db.Text
  createdById     String?
  createdBy       User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdVia      String       @default("manual")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  activities                   Activity[]
  activityParticipations       ActivityPerson[]
  notesRel                     Note[]
  opportunitiesAsDecisionMaker Opportunity[]               @relation("OpportunityDecisionMaker")
  opportunitiesAsSponsor       Opportunity[]               @relation("OpportunitySponsor")
  convertedInboundLeads        InboundLead[]               @relation("InboundLeadConvertedPerson")
  companyRelationships         PersonCompanyRelationship[]
  linkedCommercialPartners     CommercialPartner[]         @relation("CommercialPartnerLinkedPerson")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([companyId])
  @@index([email])
  @@index([createdById])
  @@map("people")
}

model Opportunity {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  companyId         String
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name              String
  stageId           String
  stage             PipelineStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  estimatedValue    Decimal?      @db.Decimal(14, 2)
  probability       Int?
  source            String?
  mainPain          String?       @db.Text
  urgency           String?
  decisionMakerId   String?
  decisionMaker     Person?       @relation("OpportunityDecisionMaker", fields: [decisionMakerId], references: [id], onDelete: SetNull)
  sponsorId         String?
  sponsor           Person?       @relation("OpportunitySponsor", fields: [sponsorId], references: [id], onDelete: SetNull)
  nextStep          String?
  nextStepDueDate   DateTime?
  expectedCloseDate DateTime?
  status            String        @default("open")
  lossReason        LossReason?
  ownerId           String?
  owner             User?         @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdVia        String        @default("manual")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  activities            Activity[]
  notes                 Note[]
  meetings              Meeting[]
  convertedInboundLeads InboundLead[]                  @relation("InboundLeadConvertedOpportunity")
  commercialPartners    OpportunityCommercialPartner[]
  commercialOffers      CommercialOffer[]

  @@index([organizationId, stageId])
  @@index([organizationId, status])
  @@index([companyId])
  @@index([createdById])
  @@index([ownerId])
  @@index([nextStepDueDate])
  @@map("opportunities")
}

// Relación N:M entre personas y empresas. Person.companyId/roleTitle se
// mantienen temporalmente como espejo de la relación principal.
model PersonCompanyRelationship {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles          String[]     @default(["contact"])
  roleTitle      String?
  isPrimary      Boolean      @default(false)
  startedAt      DateTime?
  endedAt        DateTime?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([personId, companyId])
  @@index([organizationId, companyId])
  @@index([organizationId, personId])
  @@map("person_company_relationships")
}

model CommercialPartner {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  displayName     String
  kind            String       @default("external")
  linkedCompanyId String?
  linkedCompany   Company?     @relation("CommercialPartnerLinkedCompany", fields: [linkedCompanyId], references: [id], onDelete: SetNull)
  linkedPersonId  String?
  linkedPerson    Person?      @relation("CommercialPartnerLinkedPerson", fields: [linkedPersonId], references: [id], onDelete: SetNull)
  isActive        Boolean      @default(true)
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  companyAssignments     CompanyCommercialPartner[]
  opportunityAssignments OpportunityCommercialPartner[]
  offerProfitShares      CommercialOfferProfitShare[]

  @@index([organizationId, isActive])
  @@index([linkedCompanyId])
  @@index([linkedPersonId])
  @@map("commercial_partners")
}

model CompanyCommercialPartner {
  id                           String            @id @default(cuid())
  organizationId               String
  organization                 Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  companyId                    String
  company                      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  commercialPartnerId          String
  commercialPartner            CommercialPartner @relation(fields: [commercialPartnerId], references: [id], onDelete: Cascade)
  role                         String
  defaultProfitSharePercentage Decimal?          @db.Decimal(5, 2)
  notes                        String?           @db.Text
  isActive                     Boolean           @default(true)
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  opportunityAssignments OpportunityCommercialPartner[]

  @@unique([companyId, commercialPartnerId])
  @@index([organizationId, companyId])
  @@index([commercialPartnerId])
  @@map("company_commercial_partners")
}

model OpportunityCommercialPartner {
  id                         String                    @id @default(cuid())
  organizationId             String
  organization               Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunityId              String
  opportunity                Opportunity               @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  commercialPartnerId        String
  commercialPartner          CommercialPartner         @relation(fields: [commercialPartnerId], references: [id], onDelete: Cascade)
  companyCommercialPartnerId String?
  companyCommercialPartner   CompanyCommercialPartner? @relation(fields: [companyCommercialPartnerId], references: [id], onDelete: SetNull)
  role                       String
  profitSharePercentage      Decimal?                  @db.Decimal(5, 2)
  notes                      String?                   @db.Text
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@unique([opportunityId, commercialPartnerId])
  @@index([organizationId, opportunityId])
  @@index([commercialPartnerId])
  @@map("opportunity_commercial_partners")
}

model CommercialOffer {
  id                        String       @id @default(cuid())
  organizationId            String
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  opportunityId             String
  opportunity               Opportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  versionNumber             Int
  status                    String       @default("draft")
  offerorName               String
  presenterTeamMemberId     String?
  presenterTeamMember       TeamMember?  @relation(fields: [presenterTeamMemberId], references: [id], onDelete: SetNull)
  presenterNameSnapshot     String?
  productName               String?
  sentAt                    DateTime?
  validBusinessDays         Int?
  validUntil                DateTime?
  pricingUnit               String       @default("CLP")
  plusVat                   Boolean      @default(true)
  exchangeRateToClp         Decimal?     @db.Decimal(18, 6)
  exchangeRateDate          DateTime?
  exchangeRateSource        String?
  executiveSummary          String?      @db.Text
  painSummary               String?      @db.Text
  solutionSummary           String?      @db.Text
  implementationPlan        String?      @db.Text
  outOfScope                String?      @db.Text
  commercialTerms           String?      @db.Text
  risks                     String?      @db.Text
  nextSteps                 String?      @db.Text
  economicScope             String?
  economicScopeLabel        String?
  economicBaseNetAmount     Decimal?     @db.Decimal(18, 4)
  projectCostAmount         Decimal?     @db.Decimal(18, 4)
  distributableProfitAmount Decimal?     @db.Decimal(18, 4)
  createdVia                String       @default("manual")
  createdById               String?
  createdBy                 User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sourceFingerprint         String?
  sourceRefs                Json?
  extractionConfidence      Float?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt

  lineItems    CommercialOfferLineItem[]
  documents    CommercialOfferDocument[]
  profitShares CommercialOfferProfitShare[]

  @@unique([opportunityId, versionNumber])
  @@unique([organizationId, sourceFingerprint])
  @@index([organizationId, status])
  @@index([opportunityId, versionNumber])
  @@index([validUntil])
  @@index([createdById])
  @@map("commercial_offers")
}

model CommercialOfferLineItem {
  id                String          @id @default(cuid())
  organizationId    String
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  commercialOfferId String
  commercialOffer   CommercialOffer @relation(fields: [commercialOfferId], references: [id], onDelete: Cascade)
  type              String
  description       String
  quantity          Decimal?        @db.Decimal(18, 4)
  amount            Decimal         @db.Decimal(18, 4)
  pricingUnit       String
  frequency         String?
  startMonth        Int?
  endMonth          Int?
  billingTrigger    String?
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([organizationId, commercialOfferId])
  @@map("commercial_offer_line_items")
}

model CommercialOfferDocument {
  id                    String               @id @default(cuid())
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  commercialOfferId     String
  commercialOffer       CommercialOffer      @relation(fields: [commercialOfferId], references: [id], onDelete: Cascade)
  name                  String
  documentType          String?
  externalUrl           String?
  entityContextSourceId String?
  entityContextSource   EntityContextSource? @relation(fields: [entityContextSourceId], references: [id], onDelete: SetNull)
  versionLabel          String?
  notes                 String?              @db.Text
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([organizationId, commercialOfferId])
  @@index([entityContextSourceId])
  @@map("commercial_offer_documents")
}

model CommercialOfferProfitShare {
  id                      String             @id @default(cuid())
  organizationId          String
  organization            Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  commercialOfferId       String
  commercialOffer         CommercialOffer    @relation(fields: [commercialOfferId], references: [id], onDelete: Cascade)
  beneficiaryType         String
  commercialPartnerId     String?
  commercialPartner       CommercialPartner? @relation(fields: [commercialPartnerId], references: [id], onDelete: SetNull)
  beneficiaryNameSnapshot String
  percentage              Decimal            @db.Decimal(5, 2)
  amount                  Decimal            @db.Decimal(18, 4)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@unique([commercialOfferId, beneficiaryType, commercialPartnerId])
  @@index([organizationId, commercialOfferId])
  @@index([commercialPartnerId])
  @@map("commercial_offer_profit_shares")
}

model BusinessHoliday {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  date           DateTime     @db.Date
  name           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, date])
  @@index([organizationId, date])
  @@map("business_holidays")
}

model Activity {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  personId        String?
  person          Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunityId   String?
  opportunity     Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  assigneeId      String?
  assignee        TeamMember?  @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedById   String?
  completedBy     TeamMember?  @relation("ActivityCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  type            String
  title           String
  description     String?      @db.Text
  plannedDate     DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  status          String       @default("todo")
  statusChangedAt DateTime?
  blockedReason   String?      @db.Text
  // low | medium | high. Solo tiene sentido en tareas; null = sin prioridad.
  priority        String?
  // Set = actividad ya ocurrida que se registró (llamada, email, visita...),
  // no una tarea pendiente. Es la fecha en que ocurrió.
  occurredAt      DateTime?
  durationMinutes Int?
  // Medio por el que ocurrió: teams, zoom, presencial, teléfono...
  channel         String?
  outcomes        String?      @db.Text
  createdById     String?
  createdBy       User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdVia      String       @default("manual")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Todas las personas que participaron; personId queda como la principal.
  participants ActivityPerson[]

  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, plannedDate])
  @@index([companyId])
  @@index([personId])
  @@index([opportunityId])
  @@index([assigneeId])
  @@index([completedById])
  @@index([createdById])
  @@index([organizationId, occurredAt])
  @@map("activities")
}

model ActivityPerson {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  activityId     String
  activity       Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  personId       String
  person         Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([activityId, personId])
  @@index([organizationId])
  @@index([personId])
  @@map("activity_people")
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  personId       String?
  person         Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  title          String?
  body           String       @db.Text
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdVia     String       @default("manual")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([companyId])
  @@index([personId])
  @@index([opportunityId])
  @@index([createdById])
  @@map("notes")
}

// Bandeja de entrada para leads externos (ver docs/integrations/inbound-leads.md).
// NO crea Company/Person/Opportunity automáticamente: queda pending para
// revisión humana; la conversión explícita vive en /leads.
model InboundLead {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  // Canal de origen, extensible (website_contact, referral, linkedin, campaign,
  // partner, manual, ...). String libre, mismo criterio que Opportunity.status.
  source String

  // Id del lead en el sistema de origen (ej. row id de la DB de la landing).
  // Junto con source+organizationId hace el POST de n8n idempotente a nivel DB.
  externalId String

  firstName String?
  lastName  String?
  email     String?
  company   String?
  message   String? @db.Text
  page      String?

  // new | reviewed | converted | rejected
  status String @default("new")

  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("InboundLeadReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  convertedAt            DateTime?
  convertedCompanyId     String?
  convertedCompany       Company?     @relation("InboundLeadConvertedCompany", fields: [convertedCompanyId], references: [id], onDelete: SetNull)
  convertedPersonId      String?
  convertedPerson        Person?      @relation("InboundLeadConvertedPerson", fields: [convertedPersonId], references: [id], onDelete: SetNull)
  convertedOpportunityId String?
  convertedOpportunity   Opportunity? @relation("InboundLeadConvertedOpportunity", fields: [convertedOpportunityId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, source, externalId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("inbound_leads")
}

// ---------- Views / persistence ----------

model SavedView {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Compartidas por org en v1; se registra el creador para permisos futuros.
  createdById        String?
  createdBy          User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  name               String
  entityType         EntityType
  filtersJson        Json?
  sortJson           Json?
  visibleColumnsJson Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([organizationId, entityType])
  @@map("saved_views")
}

// ---------- Custom fields ----------

model CustomFieldDefinition {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entityType     EntityType
  fieldName      String
  fieldLabel     String
  fieldType      CustomFieldType
  optionsJson    Json?
  isRequired     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  values CustomFieldValue[]

  @@unique([organizationId, entityType, fieldName])
  @@index([organizationId, entityType])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                String                @id @default(cuid())
  organizationId    String
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entityType        EntityType
  entityId          String
  fieldDefinitionId String
  fieldDefinition   CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  valueText         String?
  valueNumber       Decimal?              @db.Decimal(18, 4)
  valueBoolean      Boolean?
  valueDate         DateTime?
  valueJson         Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([entityType, entityId, fieldDefinitionId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([fieldDefinitionId])
  @@map("custom_field_values")
}

// ---------- Workflows ----------

model Workflow {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  description    String?      @db.Text
  triggerEntity  EntityType
  triggerEvent   String
  conditionsJson Json
  actionsJson    Json
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  logs WorkflowLog[]

  @@index([organizationId, triggerEntity, triggerEvent])
  @@index([isActive])
  @@map("workflows")
}

model WorkflowLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflowId     String
  workflow       Workflow     @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  entityType     EntityType
  entityId       String
  status         String
  message        String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([workflowId])
  @@index([entityType, entityId])
  @@map("workflow_logs")
}

// ---------- Integrations ----------

model IntegrationDelivery {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  type                 String
  channel              String
  entityType           EntityType
  entityId             String
  recipientJson        Json
  payloadJson          Json
  dedupeKey            String
  // pending | sent | failed
  status               String       @default("pending")
  attempts             Int          @default(0)
  lastError            String?      @db.Text
  providerResponseJson Json?
  sentAt               DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, dedupeKey])
  @@index([status])
  @@index([type])
  @@index([channel])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("integration_deliveries")
}

// ---------- Auth ----------

model User {
  id             String        @id @default(cuid())
  // Nullable SOLO para super-admins sin tenant (CHECK en SQL). Un super-admin
  // puede además pertenecer a una org (ej. el admin de Zalantos).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email          String        @unique
  passwordHash   String
  name           String?
  role           Role          @default(MEMBER)
  isActive       Boolean       @default(true)
  isSuperAdmin   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  teamMember              TeamMember?
  createdCompanies        Company[]
  createdPeople           Person[]
  createdOpportunities    Opportunity[]
  ownedOpportunities      Opportunity[]        @relation("OpportunityOwner")
  createdActivities       Activity[]
  createdNotes            Note[]
  createdCommercialOffers CommercialOffer[]
  createdSavedViews       SavedView[]
  passwordResetTokens     PasswordResetToken[]
  reviewedInboundLeads    InboundLead[]        @relation("InboundLeadReviewedBy")

  @@index([organizationId])
  @@map("users")
}

// Catálogo de personas asignables a tareas, definido por el admin. Puede
// incluir personas sin cuenta en el software; el vínculo a User es opcional
// y habilita el filtro "Mis tareas".
model TeamMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  name           String
  email          String?
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  assignedActivities        Activity[]        @relation("ActivityAssignee")
  completedActivities       Activity[]        @relation("ActivityCompletedBy")
  presentedCommercialOffers CommercialOffer[]

  @@index([organizationId])
  @@map("team_members")
}

// ---------- Meeting Intelligence ----------

model Meeting {
  id               String           @id @default(cuid())
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId    String?
  opportunity      Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  title            String
  meetingType      String           @default("discovery")
  meetingDate      DateTime
  // Free-form attendees: [{ name, email?, role? }]. Linking to Person is a later phase.
  participants     Json             @default("[]")
  status           String           @default("open")
  // Origin of the evidence pipeline: manual | audio | video | recall | meet | ...
  sourceType       String           @default("manual")
  rawTranscript    String?          @db.Text
  aiSummary        Json?
  processingStatus ProcessingStatus @default(pending)
  processingError  String?          @db.Text
  createdBy        String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  evidence  Evidence[]
  proposals CRMChangeProposal[]

  @@index([organizationId])
  @@index([companyId])
  @@index([opportunityId])
  @@index([processingStatus])
  @@map("meetings")
}

model Evidence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  meetingId      String
  meeting        Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  // audio | video | pdf | docx | txt | md | transcript
  type           String
  filename       String
  mimeType       String
  // Object key in Cloudflare R2 (empty for inline manual transcripts).
  storagePath    String
  sizeBytes      Int?
  extractedText  String?      @db.Text
  // uploaded | extracting | extracted | failed
  status         String       @default("uploaded")
  uploadedBy     String
  uploadedAt     DateTime     @default(now())

  @@index([organizationId])
  @@index([meetingId])
  @@map("evidence")
}

model CRMChangeProposal {
  id              String         @id @default(cuid())
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Optional since proposals can also originate from the agent chat.
  meetingId       String?
  meeting         Meeting?       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  // meeting | agent | enrichment
  source          String         @default("meeting")
  // legacy | web | telegram | mcp | meeting | enrichment | workflow
  channel         String         @default("legacy")
  // User that originated the AI action. Logical ref so historical rows and
  // service-generated changes can keep null without coupling retention to User.
  initiatedBy     String?
  // Denormalized context (backfilled from the meeting for legacy rows).
  companyId       String?
  opportunityId   String?
  personId        String?
  // Logical refs to the agent chat (no FK, same convention as TimelineEvent.refId).
  chatThreadId    String?
  chatMessageId   String?
  // Logical ref to EntityContextSource when source=enrichment.
  contextSourceId String?
  confidence      Float
  status          ProposalStatus @default(pending)
  // Model that produced the proposal, for audit (e.g. groq/openai/gpt-oss-120b).
  model           String?
  rawModelOutput  Json?
  reviewedBy      String?
  reviewedAt      DateTime?
  applyStartedAt  DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())

  items CRMChangeItem[]

  @@index([organizationId])
  @@index([meetingId])
  @@index([status])
  @@index([organizationId, channel, createdAt])
  @@index([initiatedBy])
  @@index([chatThreadId])
  @@index([contextSourceId])
  @@index([personId])
  @@map("crm_change_proposals")
}

// ---------- Entity context enrichment ----------

// Fuente de evidencia ligada a company/person/opportunity (upload hoy;
// linkedin/url/agent mañana). El pipeline normaliza a extractedText.
model EntityContextSource {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // company | person | opportunity
  entityType      EntityType
  entityId        String
  // upload | linkedin | url | manual | agent
  sourceType      String       @default("upload")
  filename        String
  mimeType        String
  // Object key in Cloudflare R2 (empty for inline text sources).
  storagePath     String
  sizeBytes       Int?
  extractedText   String?      @db.Text
  // External URL or provider id (e.g. LinkedIn profile URL).
  externalRef     String?
  // uploaded | extracting | extracted | analyzing | ready | failed
  status          String       @default("uploaded")
  processingError String?      @db.Text
  uploadedBy      String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  commercialOfferDocuments CommercialOfferDocument[]

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, status])
  @@map("entity_context_sources")
}

// Perfil IA consolidado por entidad (uno por ficha). Se reescribe/mergea
// en cada análisis; el historial de fuentes vive en EntityContextSource.
model EntityContextProfile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // company | person | opportunity
  entityType     EntityType
  entityId       String
  summary        String       @db.Text
  // [{ label, value, confidence?, sourceIds? }]
  keyFacts       Json
  // string[] topics/tags
  topics         Json?
  lastAnalyzedAt DateTime
  model          String?
  rawModelOutput Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId])
  @@map("entity_context_profiles")
}

model CRMChangeItem {
  id               String            @id @default(cuid())
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  proposalId       String
  proposal         CRMChangeProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  // stage_change | create_task | add_contact | link_contact | update_pain |
  // add_note | update_sponsor | update_decision_maker | update_field |
  // log_activity | create_meeting | update_task | update_note |
  // update_activity | update_meeting
  type             String
  // Target entity type: company | opportunity | person | activity | note
  entity           String
  // Logical reference (no FK); null when the item creates a new entity.
  entityId         String?
  beforeValue      Json?
  afterValue       Json?
  // Cadenas legibles calculadas al crear la propuesta (etiqueta + diff textual).
  // Se persisten para poder renderizar el card de revisión desde la DB (p. ej. en
  // la página /agent/proposals) con paridad con el chat. Null en propuestas
  // creadas antes de esta columna.
  label            String?
  before           String?           @db.Text
  after            String?           @db.Text
  confidence       Float
  explanation      String            @db.Text
  // Verbatim quote from the transcript/document/user message that justifies
  // the change (distinct from the free-text explanation).
  evidence         String?           @db.Text
  // Existing person the dedup matched; set on link_contact items.
  duplicateOfId    String?
  approved         Boolean           @default(false)
  // Safe AI changes execute immediately; destructive changes keep this true
  // until the requester or an ADMIN approves them.
  requiresApproval Boolean           @default(false)
  // Stable order within a batch; legacy rows remain null.
  sequence         Int?
  // pending | approved | rejected | applied | failed | reverted
  status           String            @default("pending")
  appliedAt        DateTime?
  // Canonical state immediately after applying. Revert compares the current
  // touched fields with this snapshot so it never overwrites newer work.
  appliedSnapshot  Json?
  undoExpiresAt    DateTime?
  failureCode      String?
  failureMessage   String?           @db.Text
  // What to undo when reverting an applied item:
  // { createdEntityId?, opportunityId?, prevDecisionMakerId?, prevSponsorId? }.
  revertData       Json?
  revertedAt       DateTime?
  revertedBy       String?
  causedByItemId   String?
  causedByItem     CRMChangeItem?    @relation("CRMChangeItemEffects", fields: [causedByItemId], references: [id], onDelete: SetNull)
  effects          CRMChangeItem[]   @relation("CRMChangeItemEffects")

  @@index([organizationId])
  @@index([proposalId])
  @@index([causedByItemId])
  @@index([undoExpiresAt])
  @@map("crm_change_items")
}

// ---------- Agente IA (copiloto) ----------

model AgentChatThread {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  title          String?
  // Page context captured when the thread was opened (e.g. company being viewed).
  contextType    EntityType?
  contextId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  messages AgentChatMessage[]

  @@index([organizationId])
  @@index([userId, updatedAt])
  @@map("agent_chat_threads")
}

model AgentChatMessage {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  threadId       String
  thread         AgentChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  // user | assistant
  role           String
  // AI SDK UIMessage.parts stored verbatim so the UI re-renders tool cards on reload.
  parts          Json
  createdAt      DateTime        @default(now())

  @@index([organizationId])
  @@index([threadId, createdAt])
  @@map("agent_chat_messages")
}

model AgentAttachment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Logical ref to AgentChatThread (no FK, mirrors Evidence's storage shape).
  threadId       String
  filename       String
  mimeType       String
  // Object key in R2; empty when R2 isn't configured (text-only fallback).
  storagePath    String
  sizeBytes      Int?
  extractedText  String?      @db.Text
  // uploaded | extracted | failed
  status         String       @default("uploaded")
  uploadedBy     String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([threadId])
  @@map("agent_attachments")
}

// Vincula un chat de Telegram con un usuario del CRM. La organización se deriva
// del usuario. n8n resuelve tenant/usuario por telegramChatId (vía prismaSystem);
// la UI admin lista/gestiona estos vínculos scopeados por org (forOrg).
model TelegramLink {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // String plano sin FK, igual que AgentChatThread.userId.
  userId           String
  telegramChatId   String       @unique
  telegramUsername String?
  // Thread persistente del copiloto para este chat; creado lazy en el 1er mensaje.
  agentThreadId    String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId])
  @@map("telegram_links")
}

// Código efímero de un solo uso para el handshake de vinculación de Telegram.
model TelegramLinkCode {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  // 6 chars alfanuméricos en mayúscula; TTL corto; single-use.
  code           String       @unique
  expiresAt      DateTime
  used           Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("telegram_link_codes")
}

// Token personal para clientes MCP. El secreto se muestra una sola vez y la
// base guarda únicamente su hash sha256.
model McpAccessToken {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // String plano sin FK: replica AgentChatThread.userId y TelegramLink.userId.
  userId         String
  name           String
  tokenHash      String       @unique
  tokenPrefix    String
  // Thread persistente para que sus propuestas aparezcan en la bandeja web.
  agentThreadId  String?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("mcp_access_tokens")
}

model TimelineEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunityId  String?
  // meeting_created | proposal_applied | note_added | stage_changed | task_created
  type           String
  title          String
  summary        String?      @db.Text
  // Reference back to the source record (meeting | proposal | note | ...).
  refType        String?
  refId          String?
  actorId        String?
  metadata       Json?
  occurredAt     DateTime     @default(now())

  @@index([organizationId])
  @@index([companyId, occurredAt])
  @@index([opportunityId])
  @@map("timeline_events")
}
